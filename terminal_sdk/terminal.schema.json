{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Logos Terminal module manifest 1.0.0",
  "description": "Versioned manifest for a local, separately launched terminal adapter. Input is never a shell command string. Unknown optional fields are ignored by API 1.x hosts.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "api_version",
    "min_host_version",
    "protocol",
    "command",
    "actions"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "logos-terminal/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "maxLength": 300
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "api_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "min_host_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "protocol": {
      "enum": [
        "jsonrpc",
        "text"
      ]
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cwd": {
      "type": "string"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "placeholder": {
            "type": "string",
            "maxLength": 300
          },
          "button": {
            "type": "string",
            "maxLength": 24
          },
          "allow_empty": {
            "type": "boolean"
          },
          "translations": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "file",
        "fields"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label",
              "type"
            ],
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "type": {
                "enum": [
                  "string",
                  "file",
                  "integer",
                  "number"
                ]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
