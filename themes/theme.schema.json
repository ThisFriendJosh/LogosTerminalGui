{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Logos Terminal Theme v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "description",
    "palette",
    "typography",
    "components",
    "effects"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema": {
      "const": "logos-terminal-theme/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400,
      "pattern": "^[^\\u0000-\\u001f]+$"
    },
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "panel",
        "field",
        "accent",
        "accent_bright",
        "text",
        "muted",
        "edge",
        "error",
        "selection",
        "selection_text",
        "code_background",
        "placeholder",
        "disabled",
        "button_fill",
        "button_disabled",
        "footer",
        "user",
        "border_glow",
        "brand"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "panel": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "field": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent_bright": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "edge": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "error": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "selection": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "selection_text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "code_background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "placeholder": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "disabled": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "button_fill": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "button_disabled": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "footer": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "user": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "border_glow": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "brand": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families"
      ],
      "properties": {
        "families": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\u0000-\\u001f]+$"
          }
        }
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "button_style",
        "module_icons",
        "terminal_prompts"
      ],
      "properties": {
        "button_style": {
          "enum": [
            "classic",
            "phosphor"
          ]
        },
        "module_icons": {
          "type": "boolean"
        },
        "terminal_prompts": {
          "type": "boolean"
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digital_rain",
        "text_glow",
        "scanlines",
        "pulse",
        "block_cursor",
        "frame_rate"
      ],
      "properties": {
        "digital_rain": {
          "type": "boolean"
        },
        "text_glow": {
          "type": "boolean"
        },
        "scanlines": {
          "type": "boolean"
        },
        "pulse": {
          "type": "boolean"
        },
        "block_cursor": {
          "type": "boolean"
        },
        "frame_rate": {
          "type": "integer",
          "minimum": 4,
          "maximum": 15
        }
      }
    }
  }
}
